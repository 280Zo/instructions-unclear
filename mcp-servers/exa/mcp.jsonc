{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/mcp-schema.json",
  "mcpServers": {
    "exa": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,agent_run",
      "headers": { "x-api-key": "${EXA_API_KEY}" }
    }
  },
  // OpenCode only: read the key from a file in the login session's runtime
  // directory instead of an environment variable. OpenCode substitutes {env:}
  // before {file:} (verified on 2.1.3). Other tools keep ${EXA_API_KEY}.
  "opencode": {
    "mcpServers": {
      "exa": {
        "type": "http",
        "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,agent_run",
        "headers": { "x-api-key": "{file:{env:XDG_RUNTIME_DIR}/opencode/exa.key}" },
        // The key is supplied, so don't start an OAuth sign-in.
        "oauth": false
      }
    }
  }
}
