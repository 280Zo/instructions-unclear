{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/mcp-schema.json",
  "mcpServers": {
    "pmb": {
      "type": "stdio",
      // Installed with `uv tool install pmb-ai`; update with `uv tool upgrade --all`.
      "command": "pmb-mcp",
      "args": [],
      // Start PMB in the current project, so PMB_HOME=.pmb lands in that project.
      "cwd": ".",
      "env": { "PMB_HOME": ".pmb" }
    }
  }
}
