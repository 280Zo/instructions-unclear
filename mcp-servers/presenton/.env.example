# Copy to .env (git ignores it) and fill in. Variable names are from
# https://docs.presenton.ai/hosting/environment-variables

# Admin account, created on first start. Needed to make the MCP API key.
AUTH_USERNAME=admin
AUTH_PASSWORD=replace-with-a-long-password

# Text provider: set LLM and that provider's key and model. Pick one block.
LLM=anthropic
ANTHROPIC_API_KEY=replace-with-your-key
ANTHROPIC_MODEL=replace-with-a-model-id

# LLM=openai
# OPENAI_API_KEY=replace-with-your-key
# OPENAI_MODEL=gpt-4.1

# LLM=google
# GOOGLE_API_KEY=replace-with-your-key
# GOOGLE_MODEL=models/gemini-2.0-flash

# LLM=ollama
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.2:3b
# START_OLLAMA=false

# Images: comment this out and set IMAGE_PROVIDER (and its key) to enable them.
DISABLE_IMAGE_GENERATION=true

# Presenton sends anonymous usage data unless this is true.
DISABLE_ANONYMOUS_TRACKING=true
