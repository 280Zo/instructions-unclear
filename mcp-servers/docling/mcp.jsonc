{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/mcp-schema.json",
  "mcpServers": {
    "docling": {
      "type": "stdio",
      // Installed with `uv tool install 'docling-mcp[local]'`;
      // update with `uv tool upgrade --all`.
      "command": "docling-mcp-server",
      "args": [
        "conversion", "generation",
        "--transport", "stdio"
      ],
      // Large conversions can take minutes; 5-minute timeout.
      "timeout": 300000,
      "env": {
        "DOCLING_MCP_CONVERSION_MODE": "local",
        "CACHE_DIR": "/tmp/opencode/docling",
        "DOCLING_MCP_KEEP_IMAGES": "true"
      }
    }
  }
}
