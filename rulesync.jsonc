{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  // Everything in this repo is user-level configuration. ALWAYS run
  // generate with --global: rulesync ignores "global": true in this file
  // when inputRoots is set, and without the flag it writes into this repo.
  // OpenCode by default. Pass --targets to generate for other assistants.
  "targets": ["opencode"],
  // A complete install. If you already have these skills and MCP servers
  // set up by hand, run with --features rules,subagents instead (see README).
  "features": ["rules", "subagents", "skills", "commands", "mcp"],
  // Never delete files rulesync did not create (installed skills, etc.).
  "delete": false,
  // Each folder below is one source tree. Rules from all of them are merged
  // into one AGENTS.md in this order; MCP servers from every mcp.jsonc are
  // merged. Keep rules/shell-preamble first and its reminder last.
  "inputRoots": [
    "rules/shell-preamble",
    "rules/scope-secrets-approvals",
    "rules/engineering",
    "agents/security",
    "rules/communication",
    "rules/routing",
    "rules/preferences",
    "skills/package-management",
    "agents/second-opinion",
    "mcp-servers/docling",
    "mcp-servers/exa",
    "mcp-servers/pmb",
    "mcp-servers/presenton",
    "mcp-servers/freecad",
    "mcp-servers/codebase-memory",
    "skills/eli5",
    "skills/report",
    "skills/humanizer",
    "skills/visual-explainer",
    "skills/diagram-design",
    "skills/frontend-slides",
    "skills/anthropic-design",
    "skills/transcribe",
    "skills/speech",
    "skills/screenshot",
    "skills/playwright",
    "skills/documents",
    "skills/geo-sleuth",
    "skills/distilly",
    "agents/local-model",
    "rules/shell-preamble-reminder"
  ]
}
