{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  // AI research profile: the 98 AI-Research-SKILLs, installed into one folder
  // instead of your home folder. Run from the repo root; paths below are
  // relative to it. See this folder's README. Never run this with --global.
  "targets": ["opencode"],
  "features": ["skills"],
  "delete": false,
  "inputRoots": ["skills/ai-research"]
}
