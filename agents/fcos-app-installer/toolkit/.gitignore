# Private data never goes in git. The real config and everything rendered
# from it live in the workspace, a folder outside this repo (tools/workspace.py
# refuses one inside it); published files use placeholders only.
# tools/publish_check.py enforces this. The /config.yaml and /vms/ lines below are
# a safety net for stray v1-style files.
/config.yaml
/vms/
/notes/

# Planning documents are not part of the published repo.
/docs/design/
/docs/superpowers/

# The global gitignore excludes .opencode/; if you commit this folder, publish only the agents,
# commands and skills rulesync wrote there, nothing else OpenCode keeps there.
!/.opencode/
/.opencode/*
!/.opencode/agents/
!/.opencode/commands/
!/.opencode/skills/

# Python caches
__pycache__/
