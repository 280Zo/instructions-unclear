# Container images the desktop-side tools run (tools/build-vm.sh, tools/make_cidata_iso.sh).
# Pinned by tag and digest, so a rebuild of a tag can't change what runs: Butane writes
# every VM's boot config. Read, never executed. Update only through the procedure in
# README.md "Updating"; tools/check_updates.py reports newer releases.
# Verified on quay.io: butane v2.28.0 (= its "release" tag), podman/stable v5.8.9.
BUTANE_IMAGE=quay.io/coreos/butane:v2.28.0@sha256:143e7efd568e46e6f2bcb6f4250d01b0b49227232cc21a7150f8d39e577b9ea5
PODMAN_IMAGE=quay.io/podman/stable:v5.8.9@sha256:f7a17ef911a2b9b866ada8a9426a07e29a6e4f8109ef8c0e0b7010c2541b4e49
