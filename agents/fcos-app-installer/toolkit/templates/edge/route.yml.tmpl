# Route for {{ROUTE_NAME}}: https://{{ROUTE_HOST}} -> {{ROUTE_BACKEND}}
# behind Authentik forward auth. To drop the login for this app, remove the
# middlewares line (and record why in the service config).
# Names are quoted so a service called e.g. "null" or "on" stays a string.
http:
  routers:
    "{{ROUTE_NAME}}":
      rule: "Host(`{{ROUTE_HOST}}`)"
      entryPoints: [websecure]
      middlewares: [authentik]
      service: "{{ROUTE_NAME}}"
      priority: 10
    "{{ROUTE_NAME}}-outpost":
      rule: "Host(`{{ROUTE_HOST}}`) && PathPrefix(`/outpost.goauthentik.io/`)"
      entryPoints: [websecure]
      service: authentik-outpost
      priority: 15
{{REDIRECT_ROUTERS}}
{{REDIRECT_MIDDLEWARES}}
  services:
    "{{ROUTE_NAME}}":
      loadBalancer:
        servers:
          - url: "{{ROUTE_BACKEND}}"
