# Traefik dynamic file 00-authentik.yml, shared by every route: the Authentik
# forward-auth middleware, the outpost service, and the route to Authentik
# itself (no middleware on it). Written by tools/login_frontend.py.
# Forward-auth settings: docs.goauthentik.io/add-secure-apps/providers/proxy/server_traefik/
http:
  middlewares:
    authentik:
      forwardAuth:
        address: http://127.0.0.1:9000/outpost.goauthentik.io/auth/traefik
        trustForwardHeader: true
        maxResponseBodySize: 4194304
        # The JWT header (X-authentik-j-w-t) is left out: it carries every user attribute (a profile picture
        # can be hundreds of KB) and apps refuse headers over ~8 KB; no app here uses it.
        authResponseHeaders:
          - X-authentik-username
          - X-authentik-groups
          - X-authentik-entitlements
          - X-authentik-email
          - X-authentik-name
          - X-authentik-uid
          - X-authentik-meta-jwks
          - X-authentik-meta-outpost
          - X-authentik-meta-provider
          - X-authentik-meta-app
          - X-authentik-meta-version
  routers:
    authentik:
      rule: "Host(`{{AUTHENTIK_HOST}}`)"
      entryPoints: [websecure]
      service: authentik-server
  services:
    authentik-server:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:9000"
    authentik-outpost:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:9000/outpost.goauthentik.io"
