variant: fcos
version: 1.7.0

# Base for every VM: admin user, hostname, data disk, OS and container update
# windows. NFS shares, firewall and services are separate fragments.

passwd:
  users:
    - name: {{ADMIN_USER}}
      groups: [wheel, sudo]
      ssh_authorized_keys:
        - {{ADMIN_SSH_PUBKEY}}
      password_hash: "{{ADMIN_PASSWORD_HASH}}"

storage:
  filesystems:
    # The second disk (the hypervisor's scsi1), kept across rebuilds. Ignition formats it only when it
    # has no matching filesystem yet; it never wipes existing data.
    - device: /dev/disk/by-id/scsi-0QEMU_QEMU_HARDDISK_drive-scsi1
      format: xfs
      label: appdata
      path: /var/lib/appdata
      wipe_filesystem: false
      with_mount_unit: true
  directories:
    - path: /var/mnt
      mode: 0755
  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: {{VM_NAME}}
    # Exit 1 unless every argument is a real mount. An automount point is an
    # autofs mount even while NFS is down, so list the directory first (which
    # triggers the real mount), then reject an empty or autofs-only result.
    # Services run it as ExecStartPre (missing storage = fail); backups run it
    # as ExecCondition (missing NAS = skip).
    - path: /usr/local/bin/require-mounts
      mode: 0755
      contents:
        inline: |
          #!/bin/sh
          status=0
          for m in "$@"; do
            timeout 30 ls -A "$m" >/dev/null 2>&1
            fstype=$(findmnt -n -o FSTYPE --mountpoint "$m" | tail -n 1)
            case "$fstype" in
              ""|autofs)
                echo "require-mounts: $m is not mounted" >&2
                status=1
                ;;
            esac
          done
          exit $status
    # OS reboots only inside the maintenance window.
    - path: /etc/zincati/config.d/55-updates-strategy.toml
      mode: 0644
      contents:
        inline: |
          [updates]
          strategy = "periodic"

          [updates.periodic]
          time_zone = "{{TIMEZONE}}"

          [[updates.periodic.window]]
          days = [ {{ZINCATI_DAYS}} ]
          start_time = "{{ZINCATI_START}}"
          length_minutes = {{ZINCATI_MINUTES}}
    # Container updates for rootful containers (system timer) ...
    - path: /etc/systemd/system/podman-auto-update.timer.d/10-schedule.conf
      mode: 0644
      contents:
        inline: |
          [Timer]
          OnCalendar=
          OnCalendar={{CONTAINER_UPDATE_ONCALENDAR}}
          RandomizedDelaySec=0
    # ... and for rootless containers (user timer, every user).
    - path: /etc/systemd/user/podman-auto-update.timer.d/10-schedule.conf
      mode: 0644
      contents:
        inline: |
          [Timer]
          OnCalendar=
          OnCalendar={{CONTAINER_UPDATE_ONCALENDAR}}
          RandomizedDelaySec=0
  links:
    - path: /etc/systemd/user/timers.target.wants/podman-auto-update.timer
      target: /usr/lib/systemd/user/podman-auto-update.timer
      hard: false

systemd:
  units:
    - name: podman-auto-update.timer
      enabled: true
