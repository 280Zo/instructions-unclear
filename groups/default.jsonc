{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  // The repo's default selection, into OpenCode. Mirrors rulesync.jsonc; keep
  // the two in sync. Run from the repo root with --global. Writes MCP settings.
  "targets": ["opencode"],
  "features": ["rules", "subagents", "skills", "commands", "mcp"],
  "delete": false,
  "inputRoots": [
    "rules/shell-preamble",
    "rules/scope-secrets-approvals",
    "rules/engineering",
    "agents/security",
    "rules/communication",
    "rules/routing",
    "rules/preferences",
    "skills/package-management",
    "agents/second-opinion",
    "mcp-servers/docling",
    "mcp-servers/exa",
    "mcp-servers/pmb",
    "mcp-servers/presenton",
    "mcp-servers/freecad",
    "mcp-servers/codebase-memory",
    "skills/eli5",
    "skills/report",
    "skills/humanizer",
    "skills/visual-explainer",
    "skills/diagram-design",
    "skills/frontend-slides",
    "skills/anthropic-design",
    "skills/transcribe",
    "skills/speech",
    "skills/screenshot",
    "skills/playwright",
    "skills/documents",
    "skills/geo-sleuth",
    "skills/distilly",
    "agents/local-model",
    "rules/shell-preamble-reminder"
  ]
}
